rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(db)/documents/config/admins)
        && (
          request.auth.uid in get(/databases/$(db)/documents/config/admins).data.get('uids', [])
          || (request.auth.token.email_verified == true
              && request.auth.token.email in get(/databases/$(db)/documents/config/admins).data.get('emails', []))
        );
    }

    // Gilt für echte (scores, events) und Vorschau-Sammlungen (test_scores, test_events).
    function isScores(col) { return col in ['scores','test_scores']; }
    function isEvents(col) { return col in ['events','test_events']; }

    // Bestenliste: Dokument-ID = "<spiel>__<name klein>". Der Ersteller besitzt den Namen,
    // nur er darf ihn erhöhen (nie senken). Fremde Namen sind damit serverseitig geschützt.
    // Chat, Ideen, Namensanträge und Admin-Aktionen sind unveränderliche Ereignisse.
    match /{col}/{id} {
      allow read: if isScores(col) || isEvents(col);

      allow create: if signedIn() && (
        (isScores(col)
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.score is number
          && request.resource.data.score > 0
          && request.resource.data.score < 100000000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24
          && request.resource.data.cat is string
          && id == request.resource.data.cat + '__' + request.resource.data.name.lower())
        ||
        (isEvents(col)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.keys().hasOnly(['type','uid','ts','msg','idea','renameReq','msgId','ideaId','reqId','approvedRename','clearedBefore'])
          && (request.resource.data.type in ['CHAT_MSG','IDEA_ADD','RENAME_REQ'] || isAdmin()))
      );

      allow update: if signedIn() && isScores(col)
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.name == resource.data.name
        && request.resource.data.cat == resource.data.cat
        && request.resource.data.score is number
        && request.resource.data.score > resource.data.score;

      allow delete: if (isScores(col) || isEvents(col)) && isAdmin();
    }

    // Anonyme Spielstatistik: ein Zähler-Dokument je Spiel und Tag ("<YYYY-MM-DD>__<spiel>") und
    // ein Marker je Spieler (stats/<tag>__<spiel>/players/<uid>). Gilt auch für test_stats (Vorschau).
    function isStats(col) { return col in ['stats','test_stats']; }
    function sNew(k, cap) {
      return request.resource.data.get(k, 0) is int
        && request.resource.data.get(k, 0) >= 0
        && request.resource.data.get(k, 0) <= cap;
    }
    function sInc(k, cap) {
      return request.resource.data.get(k, 0) is int
        && request.resource.data.get(k, 0) - resource.data.get(k, 0) >= 0
        && request.resource.data.get(k, 0) - resource.data.get(k, 0) <= cap;
    }
    // "players" darf nur wachsen, wenn im selben Schreibvorgang der eigene Marker neu angelegt wird.
    function sMarkerNew(col, id) {
      return existsAfter(/databases/$(db)/documents/$(col)/$(id)/players/$(request.auth.uid))
        && !exists(/databases/$(db)/documents/$(col)/$(id)/players/$(request.auth.uid));
    }

    match /{statsCol}/{statsId} {
      allow read: if isStats(statsCol) && isAdmin();

      allow create: if signedIn() && isStats(statsCol)
        && request.resource.data.keys().hasOnly(['day','game','rounds','finished','secs','restarts','aborts','players'])
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.game in ['forklift','mario','buster','nerve','parcours']
        && statsId == request.resource.data.day + '__' + request.resource.data.game
        && sNew('rounds', 100) && sNew('finished', 100) && sNew('restarts', 100) && sNew('aborts', 100)
        && sNew('secs', 7200) && sNew('players', 1)
        && (request.resource.data.get('players', 0) == 0 || sMarkerNew(statsCol, statsId));

      allow update: if signedIn() && isStats(statsCol)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rounds','finished','secs','restarts','aborts','players'])
        && sInc('rounds', 100) && sInc('finished', 100) && sInc('restarts', 100) && sInc('aborts', 100)
        && sInc('secs', 7200) && sInc('players', 1)
        && (request.resource.data.get('players', 0) == resource.data.get('players', 0) || sMarkerNew(statsCol, statsId));

      // kein delete: ohne passende allow-Regel verboten
    }

    match /{statsCol}/{statsId}/players/{pid} {
      allow read: if isStats(statsCol) && isAdmin();
      allow create: if signedIn() && isStats(statsCol)
        && pid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ts']);
      // kein update, kein delete
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;   // nur in der Firebase-Konsole pflegen
    }
  }
}
